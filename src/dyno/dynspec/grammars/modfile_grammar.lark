?start: modfile


modfile: (var_statement | par_statement | varexo_statement | pred_statement | parinit_statement)*   \
    model_block \
    (command_statement | steady_block | initval_block | endval_block | histval_block | shocks_block | parinit_statement)*
    

varexo_statement: "varexo" (lsymbol ","?)* lsymbol ";"
var_statement: "var" (lsymbol ","?)* lsymbol ";"
par_statement: "parameters" (lsymbol ","?)* lsymbol ";"
pred_statement: "predetermined_variables" (lsymbol ","?)* lsymbol ";"

?parinit_statement: parassignment ";"

lsymbol: cname ["$" latex_string "$"] ["(" properties ")"]

latex_string: LATEX_STRING


# TODO

command_statement: COMMAND ";"
    | COMMAND "(" [command_arg ("," command_arg)*] ")" (cname *) ";"
    | COMMAND (cname *) ";"

command_arg: cname "=" NUMBER -> cmd_opt_num
    | cname "=" cname         -> cmd_opt_name
    | cname                   -> cmd_opt_flag


model_block.1: "model" ";" _list_of_equations _END_TOKEN ";"
    | "model" "(" "linear" ")" ";" _list_of_equations _END_TOKEN ";"

steady_block.1: _STEADY_CMD ";" _list_of_parassignments _END_TOKEN ";"

_STEADY_CMD.2: "steady_state_model"

initval_block.1: "initval" ";" _list_of_parassignments _END_TOKEN ";"
endval_block.1: "endval" ";" _list_of_parassignments _END_TOKEN ";"

// histval; k(0) = 1.2; end;   (only the date-0 form is interpreted)
histval_block.1: "histval" ";" (histassignment ";")+ _END_TOKEN ";"
histassignment: variable "=" formula

shocks_block.1: "shocks" ["(" properties ")"] ";"  (setstdvar_stmt | setvar_stmt | setcovar_stmt | setcorr_stmt | setdetvar_stmt)*  _END_TOKEN ";"

setstdvar_stmt: "var" symbol ";" "stderr" formula ";"

// Deterministic (perfect foresight) shocks:
//   var x; periods 1:9, 10; values 0.1, (alpha*2);
setdetvar_stmt: "var" symbol ";" "periods" period_item (","? period_item)* ";" "values" value_item (","? value_item)* ";"
period_item: INT [":" INT]
value_item: NUMBER                 -> value_number
    | "-" NUMBER                   -> value_neg_number
    | "(" formula ")"              -> value_expr
setvar_stmt: "var" symbol "=" formula ";"
setcovar_stmt: "var" symbol "," symbol "=" formula ";"
setcorr_stmt: "corr" symbol "," symbol "=" formula ";"


_list_of_equations: (lequation) (";"  lequation )* ";"
_list_of_parassignments: (parassignment) (";"  parassignment )* ";"

lequation: ["[" properties "]"] equation

properties: (pair ",")* pair
pair:  NAME "=" "'" UNQUOTED_STRING "'"
    |  NAME "=" "\"" UNQUOTED_STRING "\""
    |  NAME "=" NAME
    |  NAME

?equation: equality | formula

parassignment: symbol "=" formula

// vassignment: variable "=" formula

// ?equation: equality | formula

equality: formula "=" formula


COMPARISON:  ("<="|"<"|">"|">=")
// t_inequality: "t" COMPARISON formula -> t_bound
t_double_bound: formula "<=" "t" "<" formula
// t_inequalities: (t_inequality) ("," t_inequality)* -> t_bounds

// predicate: [quantifier "," t_condition] (equality | inequality)

quantified_assignment: _FORALL "t" ["," t_double_bound] ":" variable _ASSIGN formula

_FORALL.1: ("∀" | "forall")
_ASSIGN.1: (":=" | "<-")


?formula: sum

?sum: product
    | sum "+" product   -> add
    | sum "-" product   -> sub
    | "-" product         -> neg
    | "+" product
?product: atom|pow
    | product "*" (atom|pow)  -> mul
    | product "/" (atom|pow)  -> div
?pow: atom _POW atom -> pow

_POW: "^" | "**"

?atom: NUMBER           -> number
        | symbol            
        | "(" sum ")"
        | call

?symbol: constant | value | variable

constant: cname -> constant

value: cname  "[" time "]" -> value


variable: cname  "(" time_shift  ")" -> variable

!time_shift: [SIGNED_INT2] -> shift
    | INT -> shift

!time: SIGNED_INT -> time

!cname: NAME -> name
    
?call: FUNCTION "(" formula ("," formula)* ")" -> call

_END_TOKEN: "end"

FUNCTION.1: /\b(sin|cos|exp|log|sqrt|abs|steady_state)\b/

COMMAND.1: "steady"|"check"|"stoch_simul"|"steady_state_model"|"simul"|"perfect_foresight_setup"|"perfect_foresight_solver"|"rplot"

SIGNED_INT2: ("+"|"-") INT

_NEWLINE: NEWLINE

UNICODE_LETTER: /[^\W\d_\$]/

LATEX_STRING: /[^'"\$]+/

UNQUOTED_STRING: /[^'"]+/

NAME: UNICODE_LETTER ("_"|UNICODE_LETTER|DIGIT)*

#NAME: /(?!(end)\b)[^\W\d_\$]+/i

%import common.SIGNED_INT
%import common.DIGIT
%import common.INT
%import common.NUMBER
%import common.WS_INLINE
%import common.NEWLINE

MULTILINE_COMMENT: "/*" /(.|\n)+?/ "*/"
COMMENT: ("//"|"%"|"#") /[^\n]/*

%ignore MULTILINE_COMMENT
%ignore COMMENT
%ignore WS_INLINE
%ignore NEWLINE  // comment out to avoid crash