# β     <- 
γ     <- 4.0
σ     <- 0.1
ρ     <- 0.0
r     <- 1.02    

w[~]  <- 1.0
c[~]  <- 0.9*w[~]
y[~]  <- 0.0

[states]::{
    w[t]
}
[controls]::{
    c[t]
}

w[t] = exp(y[t]) + (w[t-1]-c[t-1])*r    :: [transition]

β*( c[t+1]/c[t] )^(-γ)*r - 1  = 0          :: [arbitrage]



y[t] <- N(0,σ)

@domain: w: [0.5, 5.0]

@options: discretization: { endo: {n: [100]}, exo: {n: 7} }
